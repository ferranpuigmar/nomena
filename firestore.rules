rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Names catalogue: public read (search page is accessible without login)
    match /names/{nameId} {
      allow read: if true;
    }

    // Initial letters index: public read
    match /initial_letters/{docId} {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      // Any authenticated user can read (needed for partner display names)
      allow read: if request.auth != null;
      // Only the owner can write their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Invite codes
    match /inviteCodes/{userId} {
      // Any authenticated user can read (needed to query by code during redemption)
      allow read: if request.auth != null;
      // Only the owner can write their own invite code
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User favorites
    match /userFavorites/{userId} {
      // Owner has full access
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Partner can read if they are in shared_with
      allow read: if request.auth != null
        && request.auth.uid in resource.data.shared_with;

      // Invite redemption: allow read/write on this doc if the owner has an active invite code.
      // Needed so the redeemer can check/set the owner's userFavorites during redemption.
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/inviteCodes/$(userId));
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/inviteCodes/$(userId))
        && request.auth.uid in request.resource.data.shared_with;
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/inviteCodes/$(userId))
        && request.auth.uid in request.resource.data.shared_with;

      // Remove partner: allow a current partner to remove themselves from shared_with
      allow update: if request.auth != null
        && request.auth.uid in resource.data.shared_with
        && !(request.auth.uid in request.resource.data.shared_with);
    }
  }
}
