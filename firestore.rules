rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public catalogue (no auth required) ──
    match /names/{nameId} {
      allow read: if true;
    }

    match /initial_letters/{docId} {
      allow read: if true;
    }

    // ── User profiles ──
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Invite codes ──
    // Doc ID = the code itself (nanoid). Read is open to any auth user so the
    //   redeemer can do a direct lookup by code. Only the owner can create.
    //   Delete is allowed for any auth user (redeemer cleans it up).
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow delete: if request.auth != null;
    }

    // ── Active invite flag ──
    // Lightweight doc keyed by userId so userFavorites rules can verify an
    // active invite exists via exists(). Created on generate, deleted on redeem.
    match /userActiveInvite/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null;
    }

    // ── User favorites ──
    match /userFavorites/{userId} {
      // Owner: full access
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Partner: can only read (they are in shared_with)
      allow read: if request.auth != null
        && request.auth.uid in resource.data.shared_with;

      // ── Invite redemption ──
      // Allows the redeemer to create/update the owner's userFavorites doc
      // while the owner has an active invite (userActiveInvite doc exists).
      // The redeemer's uid must be added to shared_with.
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/userActiveInvite/$(userId))
        && request.auth.uid in request.resource.data.shared_with;
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/userActiveInvite/$(userId))
        && request.auth.uid in request.resource.data.shared_with;

      // ── Remove partner ──
      // Allows a current partner to remove themselves from shared_with.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.shared_with
        && !(request.auth.uid in request.resource.data.shared_with);
    }
  }
}
